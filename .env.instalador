APP_NAME=Droguería
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Datos que aparecen en el comprobante de venta (resources/views/pdf/invoice.blade.php)
STORE_NAME="Droguería"
STORE_LEGAL_NAME=
STORE_NIT=
STORE_ADDRESS=
STORE_CITY=
STORE_PHONE=
STORE_EMAIL=

# Rutas relativas a public/ (vacío = sólo el nombre en texto)
STORE_LOGO=images/logo.png
STORE_LOGO_PRINT=images/logo-print.png

# Ancho del rollo térmico: 80mm o 58mm
RECEIPT_WIDTH=58mm

# Caracteres por línea de la tiquetera. Es el dato que manda: si el tiquete
# sale partido, baje este número hasta que las líneas cierren en el borde.
PRINTER_COLUMNS=35

RECEIPT_FOOTER="¡Gracias por su compra!"
RECEIPT_LEGAL_NOTE="Los medicamentos no tienen devolución. Conserve este comprobante."
