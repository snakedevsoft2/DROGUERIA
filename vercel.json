{
    "version": 2,
    "buildCommand": null,
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        {
            "src": "/(build|images)/(.*)",
            "dest": "/$1/$2"
        },
        {
            "src": "/(favicon\\.ico|robots\\.txt|manifest\\.webmanifest)",
            "dest": "/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
