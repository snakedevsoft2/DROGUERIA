# ---------------------------------------------------------------------------
# Ajustes del punto de venta
#
# Este archivo se puede editar con el Bloc de notas. Después de cambiarlo hay
# que cerrar y volver a abrir el programa para que tome los cambios.
# ---------------------------------------------------------------------------

APP_NAME="__STORE_NAME__"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:__PORT__

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base de datos: el archivo database\database.sqlite dentro de la carpeta del
# programa. TODA la información del negocio vive ahí: productos, lotes y
# ventas. Es el archivo que hay que respaldar.
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Datos que salen impresos en el comprobante
# ---------------------------------------------------------------------------

STORE_NAME="__STORE_NAME__"
STORE_LEGAL_NAME=
STORE_NIT=
STORE_ADDRESS=
STORE_CITY="__STORE_CITY__"
STORE_PHONE="__STORE_PHONE__"
STORE_EMAIL=

# Imágenes dentro de la carpeta app\public\. Dejar en blanco para imprimir
# sólo el nombre en texto.
STORE_LOGO=images/logo.png
STORE_LOGO_PRINT=images/logo-print.png

RECEIPT_WIDTH=__RECEIPT_WIDTH__
RECEIPT_FOOTER="¡Gracias por su compra!"
RECEIPT_LEGAL_NOTE="Los medicamentos no tienen devolución. Conserve este comprobante."

# ---------------------------------------------------------------------------
# Impresora térmica
#
# PRINTER_NAME es el nombre con el que la impresora quedó COMPARTIDA en
# Windows (no el nombre que se ve en "Dispositivos e impresoras", sino el
# nombre del recurso compartido). Si queda vacío, el programa funciona igual
# pero el tiquete hay que imprimirlo desde el navegador.
#
# Para reconfigurarla: doble clic en "Configurar impresora" dentro de la
# carpeta del programa.
# ---------------------------------------------------------------------------

PRINTER_ENABLED=true
PRINTER_NAME=__PRINTER_NAME__
PRINTER_PROFILE=default

# Ancho del rollo en caracteres: 42 para rollo de 80mm, 32 para rollo de 58mm.
PRINTER_COLUMNS=__PRINTER_COLUMNS__

# El tiquete sale solo al confirmar la venta.
PRINTER_AUTO_PRINT=true

# Corte automático del papel (la Epson TM-T20II lo trae).
PRINTER_CUT=true

# Pulso de apertura del cajón monedero conectado a la impresora.
PRINTER_CASH_DRAWER=false

# Logo impreso como imagen en el encabezado del tiquete.
PRINTER_LOGO=true

# Código de barras con el número de factura al pie del tiquete.
PRINTER_BARCODE=true
