# ---------------------------------------------------------------------------
# Variables de entorno para Vercel
# ---------------------------------------------------------------------------
# Esto NO es un archivo que se lea en producción: Vercel no usa .env. Es la
# lista de variables que hay que pegar en:
#   Vercel > proyecto > Settings > Environment Variables
# (marcar Production, Preview y Development en cada una).
# ---------------------------------------------------------------------------

APP_NAME="Droguería"
APP_ENV=production
# Generar con: php artisan key:generate --show   (copiar incluido el "base64:")
APP_KEY=
APP_DEBUG=false
# Reemplazar por el dominio real que asigne Vercel.
APP_URL=https://tu-proyecto.vercel.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

# --- Base de datos (Neon / Postgres) --------------------------------------
# Copiar la cadena de conexión de Neon (la que empieza por postgresql://).
# Debe terminar en ?sslmode=require
DB_CONNECTION=pgsql
DB_URL=postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Ajustes obligatorios para serverless ---------------------------------
# El disco de la función es de sólo lectura salvo /tmp: los logs van a la
# consola de Vercel, las vistas Blade se compilan en /tmp, la caché vive en
# memoria y las sesiones en Postgres.
LOG_CHANNEL=stderr
LOG_LEVEL=error
VIEW_COMPILED_PATH=/tmp/storage/framework/views
CACHE_STORE=array
SESSION_DRIVER=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# --- Datos que salen impresos en el comprobante ----------------------------
STORE_NAME="Droguería"
STORE_LEGAL_NAME=
STORE_NIT=
STORE_ADDRESS=
STORE_CITY=
STORE_PHONE=
STORE_EMAIL=

STORE_LOGO=images/logo.png
STORE_LOGO_PRINT=images/logo-print.png

RECEIPT_WIDTH=80mm
RECEIPT_FOOTER="¡Gracias por su compra!"
RECEIPT_LEGAL_NOTE="Los medicamentos no tienen devolución. Conserve este comprobante."
